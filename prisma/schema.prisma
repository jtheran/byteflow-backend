// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  dni          String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  // Relación con Rol
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]
  sessions     CashSession[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // Ej: "ADMIN", "CASHIER"
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  
  // Relaciones
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  slug        String           @unique // Ej: "sales:create", "products:write"
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  
  // Relaciones
  roles       RolePermission[]

  @@map("permissions")
}

// Tabla intermedia explícita para la relación Muchos a Muchos (Roles <-> Permisos)
model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id") // Opcional por si es un intento de login fallido de un usuario inexistente
  userEmail    String?  @map("user_email")
  action       String   // Ej: "AUTH_LOGIN", "SALE_VOID", "PRODUCT_UPDATE"
  module       String   // Ej: "AUTH", "SALES", "PRODUCTS"
  description  String   // Mensaje descriptivo legible por humanos
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  statusCode   Int      @map("status_code") // 200, 403, 401, etc.
  createdAt    DateTime @default(now()) @map("created_at")

  // Relación opcional con usuarios
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Product {
  id           String        @id @default(uuid())
  sku          String        @unique // Código de barras o identificador único comercial
  name         String
  description  String?       @db.Text
  price        Decimal       @db.Decimal(12, 2) // Precio de venta regular
  cost         Decimal       @db.Decimal(12, 2) // Costo de adquisición (para calcular ganancias netas)
  stock        Int           @default(0)
  minStock     Int           @default(5)        // Umbral mínimo para alertas de reabastecimiento
  isActive     Boolean       @default(true)     // Soft delete para no romper el histórico de ventas
  expirationDate DateTime?   @map("expiration_date")
  
  // Relaciones
  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id])
  supplierId   String?
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  stockHistory StockMovement[]
  sales        SaleItem[]
  purchases    PurchaseItem[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([sku])
  @@index([name])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Supplier {
  id          String    @id @default(uuid())
  nit         String    @unique // Documento de identificación fiscal / RUT
  companyName String
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean   @default(true)
  products    Product[]
  purchases   Purchase[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StockMovement {
  id          String       @id @default(uuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity    Int          // Cantidad del movimiento (positivo para entrada, negativo para salida)
  type        MovementType // ENUM: COMPRA, VENTA, AJUSTE_INVENTARIO, DEVOLUCION, MERMA
  reason      String?      // Razón del ajuste manual (ej: "Producto dañado en bodega")
  
  // Auditoría: Quién ejecutó el movimiento
  userId      String       // ID del cajero o administrador
  userEmail   String

  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([type])
}

enum MovementType {
  COMPRA
  VENTA
  AJUSTE_INVENTARIO
  DEVOLUCION
  MERMA
}

model Client {
  id        String   @id @default(uuid())
  document  String   @unique // Cédula, NIT o Pasaporte
  name      String
  email     String?  @unique
  phone     String?  // Formato limpio para conectarlo con el bot de WhatsApp
  address   String?
  isActive  Boolean  @default(true) // Soft delete para proteger el histórico de ventas

  // Relaciones (Descomentar cuando crees el modelo Sale)
  sales     Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([document])
  @@index([name])
}

model Sale {
  id             String       @id @default(uuid())
  invoiceNumber  String       @unique // Consecutivo de factura (Ej: FACT-00001)
  total          Decimal      @db.Decimal(12, 2)
  paymentMethod  String       // EFECTIVO, TARJETA, TRANSFERENCIA
  isActive       Boolean      @default(true) // Soft delete por si se anula la venta

  // Relaciones
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id])
  items          SaleItem[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([invoiceNumber])
  @@index([clientId])
}

model SaleItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Decimal  @db.Decimal(12, 2) // Guardamos el precio histórico al momento de la venta

  // Relaciones
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Purchase {
  id             String         @id @default(uuid())
  orderNumber    String         @unique // Ej: COMP-00001
  total          Decimal        @db.Decimal(12, 2)
  status         String         @default("COMPLETED") // COMPLETED, CANCELLED
  
  // Relaciones
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  items          PurchaseItem[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderNumber])
  @@index([supplierId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2) // Precio al que compramos hoy (puede variar)

  // Relaciones
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model CashSession {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  status         String    @default("OPEN") // OPEN, CLOSED
  
  initialBalance Decimal   @db.Decimal(12, 2) @map("initial_balance")
  expectedBalance Decimal  @default(0.00) @db.Decimal(12, 2) @map("expected_balance") // Suma automática (inicial + ventas efectivo)
  actualBalance  Decimal?  @db.Decimal(12, 2) @map("actual_balance")   // Lo que el cajero contó físicamente al cerrar
  difference     Decimal?  @db.Decimal(12, 2) // expectedBalance - actualBalance (Sobrante o Faltante)
  
  notes          String?   @db.Text

  // Relación con el usuario que opera la caja
  user           User      @relation(fields: [userId], references: [id])

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("cash_sessions")
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  TWO_FOR_ONE
}

model Promotion {
  id          String        @id @default(uuid())
  name        String        // Ej: "Black Friday Lácteos" o "Promo Fin de Semana"
  description String?       @db.Text
  type        PromotionType // ENUM: PERCENTAGE, FIXED_AMOUNT, TWO_FOR_ONE
  value       Decimal       @db.Decimal(12, 2) @default(0.00) // 10.00 para %, 5000 para monto fijo
  
  // Condicionales de activación
  startDate   DateTime      @map("start_date")
  endDate     DateTime      @map("end_date")
  isActive    Boolean       @default(true) @map("is_active")

  // Alcance del descuento (Opcionales: si se dejan nulos, aplica a todo el POS)
  targetCategoryId String?   @map("target_category_id")
  targetProductId  String?   @map("target_product_id")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("promotions")
}

 